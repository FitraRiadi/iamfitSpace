# Copy to backend/.env and fill in. NEVER commit the real .env.
SECRET_KEY=change-me-to-64-random-chars
DEBUG=True

# Empty = local SQLite. Supabase pooler for live data, e.g.:
# postgresql://postgres:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Used by: python manage.py createsuperuser --noinput
DJANGO_SUPERUSER_USERNAME=fitra
DJANGO_SUPERUSER_EMAIL=fitra@iamfit.space
DJANGO_SUPERUSER_PASSWORD=change-me-too
